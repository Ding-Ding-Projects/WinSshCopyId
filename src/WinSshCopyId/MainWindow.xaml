<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinSshCopyId.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="22" RowSpacing="14"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="WinSshCopyId" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Install your SSH public key on one or more Linux hosts so you can log in without a password."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Header="Theme"
                      VerticalAlignment="Top" MinWidth="110"
                      SelectionChanged="ThemeCombo_SelectionChanged">
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
        </Grid>

        <!-- Connection -->
        <Border Grid.Row="1" CornerRadius="8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBox x:Name="HostsBox"
                         Header="Hosts (one per line; optional host:port)"
                         PlaceholderText="server1.example.com&#x0a;10.0.0.5:2222&#x0a;db.example.com"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UserBox" Grid.Column="0"
                             Header="Username (shared by all hosts)" PlaceholderText="root" />
                    <NumberBox x:Name="PortBox" Grid.Column="1"
                               Header="Default port" Value="22" Minimum="1" Maximum="65535"
                               SpinButtonPlacementMode="Inline" />
                </Grid>
                <PasswordBox x:Name="PasswordBox"
                             Header="Password (shared; used once per host to install the key)" />
            </StackPanel>
        </Border>

        <!-- Key -->
        <Border Grid.Row="2" CornerRadius="8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock Text="SSH key to install" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="KeyCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                              PlaceholderText="No key selected"
                              SelectionChanged="KeyCombo_SelectionChanged" />
                    <Button x:Name="GenerateButton" Grid.Column="1" Content="Generate new"
                            Click="GenerateButton_Click" />
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..."
                            Click="BrowseButton_Click" />
                </Grid>
                <TextBlock x:Name="KeyPreview" TextWrapping="Wrap"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="" />
            </StackPanel>
        </Border>

        <!-- Options + profile -->
        <Border Grid.Row="3" CornerRadius="8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <CheckBox x:Name="AliasCheck"
                          Content="Add a ~/.ssh/config entry for each host (User, Port, IdentityFile)" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <CheckBox x:Name="RememberCheck" Content="Save settings on exit" />
                    <CheckBox x:Name="SavePasswordCheck" Content="Also save password (encrypted, DPAPI)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SaveButton" Content="Save now" Click="SaveButton_Click" />
                    <Button x:Name="ExportButton" Content="Export profile..." Click="ExportButton_Click" />
                    <Button x:Name="ImportButton" Content="Import profile..." Click="ImportButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeployButton" Grid.Column="0" Content="Install key on all hosts"
                    Style="{ThemeResource AccentButtonStyle}" Click="DeployButton_Click" />
            <Button x:Name="TestButton" Grid.Column="1" Content="Test all"
                    Click="TestButton_Click" />
            <ProgressRing x:Name="BusyRing" Grid.Column="2" IsActive="False"
                          Width="22" Height="22" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="3" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Ready." />
        </Grid>

        <!-- Log -->
        <Border Grid.Row="5" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Log" Margin="12,10,12,4"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="8" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
