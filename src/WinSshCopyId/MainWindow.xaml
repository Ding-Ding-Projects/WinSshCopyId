<Window x:Class="WinSshCopyId.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource WorkspaceSurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" MinHeight="48" Background="{ThemeResource WorkspaceContainerBrush}" Padding="16,4,150,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ProductTitle" Text="WinSshCopyId" VerticalAlignment="Center" FontWeight="SemiBold"/>
   <Border x:Name="DragRegion" Grid.Column="1" Background="Transparent"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button x:Name="PaletteButton" Content="Commands" Click="Palette_Click" Style="{StaticResource MaterialButtonStyle}"/>
    <Button x:Name="AccessibilityButton" Content="Accessibility" Click="Accessibility_Click" Style="{StaticResource MaterialButtonStyle}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" x:Name="WorkspaceGrid">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="NavigationSurface" Background="{ThemeResource WorkspaceContainerBrush}" Padding="12"><StackPanel x:Name="NavigationPanel" Spacing="8"/></Border>
   <Grid Grid.Column="1" Padding="24" x:Name="MainArea" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="CompactTabs" Content="Workspace tabs" Visibility="Collapsed" Click="CompactTabs_Click" Style="{StaticResource MaterialButtonStyle}"/><TextBlock x:Name="PageTitle" Style="{StaticResource MaterialTitleStyle}" Text="Connections" VerticalAlignment="Center"/></StackPanel>
    <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"/>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageHost" Spacing="16"/></ScrollViewer>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{ThemeResource WorkspaceContainerBrush}" Padding="16,8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="GlobalCancel" Content="Cancel operation" Visibility="Collapsed" Click="GlobalCancel_Click" Style="{StaticResource MaterialButtonStyle}"/><TextBlock x:Name="BuildText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/></StackPanel></Grid></Border>
 </Grid>
</Window>
